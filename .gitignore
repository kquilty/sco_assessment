# NOTE: Much of this list was suggested to me by Claude

# Dependencies & build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Environment files (commit a .env.example instead)
.env
.env.*
!.env.example

# Prisma generated client (run `npx prisma generate`)
# backend/src/generated/ <--- let's include these files so they don't have to run this command

# AI agent skills generated by `prisma skills sync` (postinstall)
backend/.agents/
backend/.claude/skills/
backend/.cursor/
backend/.devin/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
